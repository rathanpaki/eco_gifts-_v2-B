# API server. The frontend's API base URL should be http://localhost:4000.
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to send credentialed requests.
FRONTEND_ORIGIN=http://localhost:3000

# Provide one Firebase Admin credential strategy before using auth or Firestore features. Keep this file out of source control.
# FIREBASE_SERVICE_ACCOUNT={"project_id":"your-project","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\firebase-service-account.json
FIREBASE_PROJECT_ID=eco-gifts-v2
FIREBASE_STORAGE_BUCKET=eco-gifts-v2.firebasestorage.app

# One-time operator input for `npm run admin:bootstrap` after this user signs up.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com

# Cookie policy. COOKIE_SECURE must be true whenever HTTPS is used.
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf
CART_COOKIE_NAME=eco_cart
SESSION_DURATION_DAYS=5
CART_DURATION_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=example.com
